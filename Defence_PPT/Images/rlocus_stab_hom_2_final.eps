%AXGEndBitmap
GR
GR
GS
[0.48 0 0 0.48017 768.00007 -0.25] CT
[1 0 0 1 0 0] CT
N
-1600 0 M
900 0 L
900 1223 L
-1600 1223 L
-1600 0 L
cp
clip
GS
0 0 translate
900 440 scale
%AXGBeginBitmap: java.awt.image.BufferedImage
{{
/RawData currentfile /ASCII85Decode filter def
/Data RawData /FlateDecode filter def
/DeviceRGB setcolorspace
<<
  /ImageType 1
  /Decode [0 1 0 1 0 1]
  /DataSource Data
  /Height 440
  /ImageMatrix [900 0 0 440 0 0]
  /Width 900
  /BitsPerComponent 8
>> image
} stopped {handleerror} if
  RawData flushfile
} exec
